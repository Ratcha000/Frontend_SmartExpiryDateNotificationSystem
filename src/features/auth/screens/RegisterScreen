  ActivityIndicator,
  Alert,
  KeyboardAvoidingView,
  Platform,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  TouchableOpacity,
  View,
  ImageBackground,
  Animated,
} from 'react-native';
import { StackNavigationProp } from '@react-navigation/stack';
import { authApi } from '../../../api/auth';
import { useAuth } from '../../../context/AuthContext';
import { AuthStackParamList } from '../../../navigation/AuthNavigator';
import { colors } from '../../../theme/colors';

// นำเข้าฟอนต์ Mali
import { useFonts, Mali_400Regular, Mali_700Bold } from '@expo-google-fonts/mali';

type RegisterScreenNavigationProp = StackNavigationProp<AuthStackParamList, 'Register'>;

interface Props {
  navigation: RegisterScreenNavigationProp;
}

// คอมโพเนนต์สำหรับเอฟเฟกต์หัวใจ
const FloatingHeart = ({ x, y, onComplete }: { x: number, y: number, onComplete: () => void }) => {
  const [animation] = useState(new Animated.Value(0));

  useEffect(() => {
    Animated.timing(animation, {
      toValue: 1,
      duration: 800,
      useNativeDriver: true,
    }).start(() => onComplete());
  }, []);

  const translateY = animation.interpolate({
    inputRange: [0, 1],
    outputRange: [0, -50],
  });
  const opacity = animation.interpolate({
    inputRange: [0, 0.8, 1],
    outputRange: [1, 1, 0],
  });

  return (
    <Animated.View style={[styles.heartContainer, { top: y - 20, left: x - 10, opacity, transform: [{ translateY }] }]}>
      <Text style={styles.heartText}>🩷</Text>
    </Animated.View>
  );
};

export default function RegisterScreen({ navigation }: Props) {
  const { login } = useAuth();
  const [email, setEmail] = useState('');
  const [displayName, setDisplayName] = useState('');
  const [password, setPassword] = useState('');
  const [role, setRole] = useState<'MANAGER' | 'EMPLOYEE'>('EMPLOYEE');
  const [loading, setLoading] = useState(false);
  const [hearts, setHearts] = useState<{ id: number; x: number; y: number }[]>([]);

  // โหลดฟอนต์
  let [fontsLoaded] = useFonts({ Mali_400Regular, Mali_700Bold });

  const handleRegister = async () => {
    if (!email || !displayName || !password) {
      Alert.alert('ข้อผิดพลาด', 'กรุณากรอกข้อมูลให้ครบถ้วน');
      return;
    }

    setLoading(true);
    try {
      const response = await authApi.register({
        email,
        displayName,
        password,
        role,
        restaurantId: null,
      });
      await login(response.token, response.user);
    } catch (err: any) {
      const message =
        err?.response?.data?.message ||
        err?.message ||
        'เกิดข้อผิดพลาดในการลงทะเบียน';
      Alert.alert('การสมัครสมาชิกล้มเหลว', message);
    } finally {
      setLoading(false);
    }
  };

  // ฟังก์ชันสร้างหัวใจ (รับ Event เพื่อเอาพิกัด)
  const triggerHeart = (evt: any) => {
    const { pageX, pageY } = evt.nativeEvent;
    setHearts((prev) => [...prev, { id: Date.now(), x: pageX, y: pageY }]);
  };

  const removeHeart = (id: number) => {
    setHearts((prev) => prev.filter((h) => h.id !== id));
  };

  if (!fontsLoaded) {
    return (
      <View style={{ flex: 1, justifyContent: 'center', alignItems: 'center' }}>
        <ActivityIndicator size="large" color="#FF9EBB" />
      </View>
    );
  }

  return (
    <View style={{ flex: 1 }}>
      <ImageBackground
        source={require('../../../../assets/wallpaperpj4.png')}
        style={styles.backgroundImage}
        blurRadius={0} // ปรับให้ภาพพื้นหลังชัดเจนเหมือนหน้า Login
      >
        <KeyboardAvoidingView
          behavior={Platform.OS === 'ios' ? 'padding' : 'height'}
          style={styles.container}
        >
          <ScrollView contentContainerStyle={styles.scrollContainer} keyboardShouldPersistTaps="handled">
            <View style={styles.hero}>
              <View style={styles.badge}>
                <Text style={styles.badgeText}>New account</Text>
              </View>
              <Text style={styles.heroTitle}>Create your account</Text>
            </View>

            <View style={styles.card}>
              <Text style={styles.title}>Create account</Text>
              <Text style={styles.subtitle}>กรอกข้อมูลเพื่อเปิดใช้งานบัญชีใหม่</Text>

              <View style={styles.inputContainer}>
                <Text style={styles.inputLabel}>Display name</Text>
                <TextInput
                  style={styles.input}
                  placeholder="สมชาย แสนดี"
                  placeholderTextColor="#B0B0B0"
                  value={displayName}
                  onChangeText={setDisplayName}
                  onTouchStart={triggerHeart} // ผูก Event ให้หัวใจเด้งตอนแตะช่องนี้
                />
              </View>

              <View style={styles.inputContainer}>
                <Text style={styles.inputLabel}>Email</Text>
                <TextInput
                  style={styles.input}
                  placeholder="example@yourrestaurant.com"
                  placeholderTextColor="#B0B0B0"
                  keyboardType="email-address"
                  autoCapitalize="none"
                  autoCorrect={false}
                  value={email}
                  onChangeText={setEmail}
                  onTouchStart={triggerHeart} // ผูก Event ให้หัวใจเด้งตอนแตะช่องนี้
                />
              </View>

              <View style={styles.inputContainer}>
                <Text style={styles.inputLabel}>Password</Text>
                <TextInput
                  style={styles.input}
                  placeholder="••••••••"
                  placeholderTextColor="#B0B0B0"
                  secureTextEntry
                  value={password}
                  onChangeText={setPassword}
                  onTouchStart={triggerHeart} // ผูก Event ให้หัวใจเด้งตอนแตะช่องนี้
                />
              </View>

              <View style={styles.inputContainer}>
                <Text style={styles.inputLabel}>Role</Text>
                <View style={styles.roleContainer}>
                  <TouchableOpacity
                    style={[styles.roleButton, role === 'EMPLOYEE' && styles.roleActive]}
                    onPress={(e) => { setRole('EMPLOYEE'); triggerHeart(e); }} // เปลี่ยน Role พร้อมทำหัวใจเด้ง
                  >
                    <Text style={[styles.roleText, role === 'EMPLOYEE' && styles.roleTextActive]}>
                      Employee
                    </Text>
                  </TouchableOpacity>
                  <TouchableOpacity
                    style={[styles.roleButton, role === 'MANAGER' && styles.roleActive]}
                    onPress={(e) => { setRole('MANAGER'); triggerHeart(e); }} // เปลี่ยน Role พร้อมทำหัวใจเด้ง
                  >
                    <Text style={[styles.roleText, role === 'MANAGER' && styles.roleTextActive]}>
                      Manager
                    </Text>
                  </TouchableOpacity>
                </View>
              </View>

              <TouchableOpacity 
                style={styles.button} 
                onPress={handleRegister} 
                disabled={loading}
                onPressIn={triggerHeart} // หัวใจเด้งตอนกดปุ่มสร้างบัญชี
              >
                {loading ? (
                  <ActivityIndicator color="#FFFFFF" />
                ) : (
                  <Text style={styles.buttonText}>Create account</Text>
                )}
              </TouchableOpacity>

              <TouchableOpacity style={styles.linkButton} onPress={() => navigation.navigate('Login')}>
                <Text style={styles.linkText}>
                  มีบัญชีอยู่แล้ว? <Text style={styles.linkAccent}>กลับไปเข้าสู่ระบบ</Text>
                </Text>
              </TouchableOpacity>
            </View>
          </ScrollView>
        </KeyboardAvoidingView>

        {/* เรนเดอร์หัวใจ */}
        {hearts.map((heart) => (
          <FloatingHeart key={heart.id} x={heart.x} y={heart.y} onComplete={() => removeHeart(heart.id)} />
        ))}
      </ImageBackground>
    </View>
  );
}

